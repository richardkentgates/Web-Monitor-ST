<h3>WordPress Site Monitor</h3>
<p>Monitor your WordPress sites — server status, daemons, and uptime at a glance.</p>

<button id="notifBtn" onclick="enableNotifications()">Enable Notifications</button>

<div id="notifStatus">
  Notifications: <strong>Unknown</strong>
</div>

<div id="countdown">Next check in: 60s</div>

<div id="addForm">
  <input id="urlInput" type="url" placeholder="https://example.com" />
  <input id="userInput" type="text" placeholder="WordPress username" />
  <input id="passInput" type="password" placeholder="Application Password" />
  <button onclick="addSite()">Add Site</button>
</div>

<button onclick="exportSites()">Export</button>
<button onclick="importSites()">Import</button>
<input id="importFile" type="file" accept="application/json" style="display:none" />

<div id="sites"></div>
